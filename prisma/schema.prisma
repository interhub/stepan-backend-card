generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is required by the AWS Lambda runtime behind Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  title       String
  description String
  location    String
  email       String
  // Short display labels are stored as a delimited string: SQLite has no array type
  // and these values are never queried on their own.
  languages   String

  skills     Skill[]
  experience Experience[]
  projects   ProjectItem[]
  links      Link[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Skill {
  id        String @id @default(cuid())
  name      String
  category  String
  level     String
  sortOrder Int    @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("skills")
}

model Experience {
  id          String  @id @default(cuid())
  company     String
  position    String
  periodStart String
  periodEnd   String?
  sortOrder   Int     @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  achievements Achievement[]

  @@unique([profileId, company, position])
  @@index([profileId])
  @@map("experience")
}

model Achievement {
  id        String @id @default(cuid())
  text      String
  sortOrder Int    @default(0)

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, text])
  @@index([experienceId])
  @@map("achievements")
}

model ProjectItem {
  id          String @id @default(cuid())
  name        String
  description String
  url         String
  tags        String
  sortOrder   Int    @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("projects")
}

model Link {
  id        String @id @default(cuid())
  label     String
  url       String
  sortOrder Int    @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, label])
  @@index([profileId])
  @@map("links")
}
